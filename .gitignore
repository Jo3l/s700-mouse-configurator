# backups y artefactos locales
*.pyc
__pycache__/
s700-backup*.json
mi-raton.json

# logs de captura que no son el de referencia
tools/probe/*.log
!tools/probe/baseline.log
tools/probe/in.ini
# lo que dejan los guiones de casos (cada uno con su config.ini aplicado)
tools/probe/cases_*.json
tools/probe/ini_*.ini

# capturas del arnés de Wine (se regeneran; se guarda la del desplegable como prueba)
tools/probe/*.png
!tools/probe/vendor_led_modes.png
tools/probe/debug/

# software del fabricante: tiene copyright, no se publica
original/
# muestras de la biblioteca de macros del fabricante (material suyo, se quedan fuera)
/*.dat

# claves TLS de desarrollo
certs/

# binarios y artefactos de compilación
dist/
native/target/

# dependencias de análisis traídas con pip --target
tools/pylibs/
node_modules/
core.*
