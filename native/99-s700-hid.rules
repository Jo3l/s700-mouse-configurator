# S700 Gaming Mouse (30FA:1540) — permite al usuario de la sesión escribir el
# feature report del ratón sin ser root. Es el mismo permiso que necesita Chrome
# para WebHID; sin esto el nodo /dev/hidraw* es 0600 root:root.
#
#   sudo cp native/99-s700-hid.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# y desconectar/volver a conectar el ratón (o reiniciar la sesión) para que
# logind aplique el ACL.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="30fa", ATTRS{idProduct}=="1540", TAG+="uaccess", MODE="0660", GROUP="input"
