# S700 Gaming Mouse (30FA:1540) — lets the logged-in user write the mouse's
# feature reports without being root. It is the same permission Chrome needs for
# WebHID; without it /dev/hidraw* is 0600 root:root.
#
#   sudo cp native/99-s700-hid.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# then unplug and replug the mouse (or log out and back in) so logind applies
# the ACL.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="30fa", ATTRS{idProduct}=="1540", TAG+="uaccess", MODE="0660", GROUP="input"
